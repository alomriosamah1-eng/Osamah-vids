# GEMINI_API_KEY: Optional. When set, the AI prompt enhancer calls Gemini to expand
# your description into a cinematic prompt. Get one at https://aistudio.google.com/apikey
# Without it the enhancer falls back to a fixed template (NOT an AI response).
GEMINI_API_KEY=""

# PORT: Port for the Express server (default 3000).
PORT=3000

# GPU_WORKER_URL: Public URL of the Colab T4 worker, e.g.
#   https://xxxx-xxxx-xxxx-xx.trycloudflare.com
# The worker prints this URL after the tunnel starts in
# colab/osamah_vids_wan21_worker.ipynb. Paste it here (or into
# storage/worker-url.txt) and the server registers it automatically on boot.
# scripts/start.sh can also pick it up from your clipboard.
GPU_WORKER_URL=""

# NODE_ENV: set to "production" to serve the built dist/ bundle instead of Vite dev middleware.
NODE_ENV=development
